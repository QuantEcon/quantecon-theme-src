+/**
+ * Collect executable `block` nodes nested below `node`, depth-first, in
+ * document order.
+ *
+ * A `{code-cell}` written inside a directive (`{exercise}`, `{solution}`,
+ * `{note}`, ...) lands at `root > block > <directive> > block[kind=notebook-code]`,
+ * which the top-level-only walk in `notebookFromMdast` never reaches - so the
+ * cell is never registered with the kernel, while the renderer still draws a
+ * run button for it (`dist/block.js` matches `block[kind=notebook-code]` at any
+ * depth). Clicking that button logs `no cell found on execute` and does
+ * nothing.
+ *
+ * Once a block is claimed we do not descend into it: its children are the
+ * code/outputs pair, never another cell. `embed` subtrees are skipped - their
+ * content belongs to another page's notebook, and `idkmap` is shared across
+ * every notebook scope of the page, so walking into them would both add
+ * phantom cells and collide keys with the source notebook.
+ */
+function nestedExecutableBlocks(node, found) {
+    const children = node.children || [];
+    for (let i = 0; i < children.length; i++) {
+        const child = children[i];
+        if (child.type === 'embed')
+            continue;
+        if (child.type === 'block' && executableNodesFromBlock(child)) {
+            found.push(child);
+            continue;
+        }
+        nestedExecutableBlocks(child, found);
+    }
+    return found;
